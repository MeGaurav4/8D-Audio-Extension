{
  "manifest_version": 3,
  "name": "8D Audio Converter",
  "version": "2.0.0",
  "description": "Turn YouTube, YouTube Music and any site's audio into smooth 8D audio, or convert your own songs to 8D files.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-8d": {
      "suggested_key": {
        "default": "Alt+Shift+8"
      },
      "description": "Turn 8D audio on or off in this tab"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": ["engine.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
